<?xml version="1.0" encoding="utf-8"?>
<!--
  Sweep's app icon: a red Wi-Fi signal symbol centered on a white
  background (paired with ic_launcher_background.xml), matching the app's
  red-and-white visual identity.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Wi-Fi glyph: three signal arcs plus a dot, scaled up and centered
         from a 24x24 source grid so it sits safely inside the adaptive
         icon's mask-safe zone. -->
    <group
        android:translateX="18"
        android:translateY="21"
        android:scaleX="3"
        android:scaleY="3">
        <path
            android:fillColor="#E53935"
            android:pathData="M1,9 L3,11 C7.97,6.03 16.03,6.03 21,11 L23,9 C16.93,2.93 7.08,2.93 1,9 Z" />
        <path
            android:fillColor="#E53935"
            android:pathData="M5,13 L7,15 C9.76,12.24 14.24,12.24 17,15 L19,13 C15.14,9.14 8.87,9.14 5,13 Z" />
        <path
            android:fillColor="#E53935"
            android:pathData="M9,17 L12,20 L15,17 C13.35,15.34 10.66,15.34 9,17 Z" />
    </group>
</vector>
